    {
      "parameters": {
        "jsCode": "// Normalize incoming form data into a clean lead object.\n// The form posts customerName / customerEmail / customerPhone, but older\n// payloads used name / email / phone - accept either.\nconst body = $input.first().json.body || $input.first().json;\n\nconst rawEmail = (body.customerEmail || body.email || '').toString().trim();\n\nconst lead = {\n  name: body.customerName || body.name || 'Unknown',\n  email: rawEmail,\n  phone: body.customerPhone || body.phone || '',\n  company: body.company || 'Not provided',\n  job_title: body.job_title || body.jobTitle || 'Not provided',\n  message: body.message || '',\n  source: body.source || 'website_form',\n  submitted_at: new Date().toISOString()\n};\n\nreturn [{ json: lead }];"
      },
      "id": "82c0a017-73ea-4ee4-83f4-1b5bb7afe111",
      "name": "Normalize Lead Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        128,
        272
      ]
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "gpt-4.1-mini",
          "mode": "list",
          "cachedResultName": "GPT-4.1-MINI"
        },
        "responses": {
          "values": [
            {
              "role": "assistant",
              "content": "=You are a lead scoring assistant for a custom jewellery store. Analyze the incoming customer lead message and score its intent from 0 to 100 based on urgency, budget readiness, and purchase intent.\n\nCustomer Name: {{ $json.name }}\nCustomer Message: {{ $json.message }}\n\nRespond ONLY with a valid JSON object in this format:\n{\n  \"score\": <number between 0 and 100>,\n  \"reason\": \"<brief explanation>\"\n}"
            }
          ]
        },
        "simplify": false,
        "builtInTools": {},
        "options": {}
      },
      "id": "e8d8b3b1-4006-4962-8489-645c8579563b",
      "name": "Message a model",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 2.3,
      "position": [
        288,
        352
      ],
      "credentials": {
        "openAiApi": {
          "id": "nc80Jub98HlgX33i",
          "name": "n8n free OpenAI API credits"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Parse the model's JSON response.\n// The scoring node is an OpenAI (langchain) node whose text lives at\n// output[0].content[0].text. Fall back to the Gemini envelope / plain text.\nconst apiResponse = $input.first().json;\n\nlet rawText = '';\nif (apiResponse.output && apiResponse.output[0] && apiResponse.output[0].content && apiResponse.output[0].content[0]) {\n  rawText = apiResponse.output[0].content[0].text;\n} else if (apiResponse.candidates && apiResponse.candidates[0]) {\n  rawText = apiResponse.candidates[0].content.parts[0].text;\n} else if (apiResponse.message && typeof apiResponse.message.content === 'string') {\n  rawText = apiResponse.message.content;\n} else if (typeof apiResponse.text === 'string') {\n  rawText = apiResponse.text;\n}\n\nlet parsed;\ntry {\n  parsed = JSON.parse(rawText);\n} catch (e) {\n  // Strip markdown code fences if the model wrapped the JSON\n  try {\n    const cleaned = (rawText || '').replace(/```json/gi, '').replace(/```/g, '').trim();\n    parsed = JSON.parse(cleaned);\n  } catch (e2) {\n    parsed = {};\n  }\n}\n\nconst score = Number(parsed.score) || 0;\nconst reasoning = parsed.reasoning || parsed.reason || 'No reasoning provided';\nlet category = parsed.category;\nif (!category) {\n  category = score >= 70 ? 'hot' : (score >= 40 ? 'warm' : 'cold');\n}\nconst key_signals = parsed.key_signals || [];\n\nconst lead = $('Normalize Lead Data').first().json;\n\nreturn [{\n  json: {\n    ...lead,\n    score,\n    category,\n    reasoning,\n    key_signals\n  }\n}];"
      },
